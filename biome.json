{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.{js,jsx,ts,tsx,vue,json}",
      "!.*",
      "!public/*",
      "!coverage",
      "!src/typings/*.d.ts",
      "!src-tauri/*",
      "!node_modules/*",
      "!tauri-plugin-hula/*",
      "!dist/*",
      "!src-tauri/gen/schemas",
      "!.release-it.json",
      "!docs/archive/*"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto",
    "bracketSameLine": true,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "noSvgWithoutTitle": "off",
        "useAltText": "off"
      },
      "complexity": {
        "useOptionalChain": "warn",
        "useLiteralKeys": "off",
        "useDateNow": "off",
        "noStaticOnlyClass": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      },
      "style": {
        "useNodejsImportProtocol": "off",
        "noNonNullAssertion": "off",
        "useNamingConvention": "off",
        "useTemplate": "off",
        "useImportType": "warn"
      },
      "suspicious": {
        "noGlobalIsNan": "off",
        "noExplicitAny": "warn",
        "noAssignInExpressions": "off",
        "noImplicitAnyLet": "off",
        "noConfusingVoidType": "off",
        "noArrayIndexKey": "off",
        "useIterableCallbackReturn": "off",
        "noConsole": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "none",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": true,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**", "**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}", "tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "style": {
            "useNamingConvention": "off",
            "useTemplate": "off",
            "useVueMultiWordComponentNames": "off"
          },
          "suspicious": {
            "noExplicitAny": "warn",
            "noAssignInExpressions": "off",
            "noImplicitAnyLet": "off"
          }
        }
      },
      "formatter": {
        "enabled": true
      }
    },
    {
      "includes": ["src/stores/**", "src/views/**", "src/components/**", "src/mobile/**", "src/layout/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "matrix-js-sdk": "Import SDK symbols via '@/services/matrix' (architectural rule: components/stores must not import matrix-js-sdk directly).",
                  "matrix-js-sdk/friend": "Import via '@/services/matrix'.",
                  "matrix-js-sdk/dm": "Import via '@/services/matrix'.",
                  "matrix-js-sdk/admin": "Import via '@/services/matrix'.",
                  "matrix-js-sdk/space": "Import via '@/services/matrix'.",
                  "matrix-js-sdk/push": "Import via '@/services/matrix'.",
                  "matrix-js-sdk/webrtc": "Import via '@/services/matrix'."
                }
              }
            }
          }
        }
      }
    }
  ]
}
