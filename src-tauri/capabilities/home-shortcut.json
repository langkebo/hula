{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "home-shortcut-capability",
  "description": "主窗口专用：全局快捷键注册/注销。仅 home 窗口初始化快捷键（App.vue 的 installSecurityListeners 按 label 判定），其余窗口不应持有该能力。",
  "platforms": ["macOS", "windows", "linux"],
