{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "network-capability",
  "description": "出网能力：http 插件 fetch 与外部域名白名单。仅授予会主动访问外部服务的窗口（Matrix 登录/同步、AI、翻译、更新检查页除外），截图/托盘/通知/更新窗口不授予。",
  "platforms": ["macOS", "windows", "linux"],
  "windows": [
    "home",
    "login",
    "about",
    "forgetPassword",
    "register",
    "onlineStatus",
    "capture",
    "rtcCall",
    "imageViewer",
    "videoViewer",
    "previewFile",
    "chat-history",
    "fileManager",
    "mail",
    "modal-remoteLogin",
    "modal-serviceAgreement",
    "modal-privacyAgreement",
    "modal-secretChat",
    "settings",
    "lockScreen",
    "multiMsg*",
    "windowChat--*"
  ],
  "permissions": [
    "http:allow-fetch",
    "http:allow-fetch-cancel",
    "http:allow-fetch-read-body",
    "http:allow-fetch-send",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://gitee.com"
        },
        {
          "url": "https://gitee.com:**"
        },
        {
          "url": "https://api.siliconflow.cn"
        },
        {
          "url": "https://api.siliconflow.cn:**"
        },
        {
          "url": "https://translate.googleapis.com"
        },
        {
          "url": "https://translate.googleapis.com:**"
        },
        {
          "url": "https://matrix.test"
        },
        {
          "url": "https://matrix.test:**"
        },
        {
          "url": "https://localhost:8008"
        },
        {
          "url": "http://localhost:8008"
        },
        {
          "url": "https://127.0.0.1:8008"
        },
        {
          "url": "http://127.0.0.1:8008"
        }
      ]
    }
  ]
}
