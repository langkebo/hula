{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default-capability",
  "description": "基础窗口能力：所有桌面窗口共用的窗口/Webview 操作、系统信息、剪贴板、通知、日志等低危权限。文件系统、网络白名单、更新器、开机自启等高危能力按窗口拆分到独立 capability。",
  "platforms": ["macOS", "windows", "linux"],
  "windows": [
    "home",
    "login",
    "tray",
    "checkupdate",
    "update",
    "about",
    "forgetPassword",
    "register",
    "onlineStatus",
    "capture",
    "notify",
    "rtcCall",
    "imageViewer",
    "videoViewer",
    "previewFile",
    "chat-history",
    "fileManager",
    "mail",
    "modal-remoteLogin",
    "modal-serviceAgreement",
    "modal-privacyAgreement",
    "modal-secretChat",
    "settings",
    "lockScreen",
    "multiMsg*",
    "windowChat--*",
    "alone*"
  ],
  "permissions": [
    "core:default",
    "core:webview:deny-internal-toggle-devtools",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-hide",
    "core:window:allow-center",
    "core:window:allow-show",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-unminimize",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-size",
    "core:window:allow-unmaximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-enabled",
    "core:window:allow-set-resizable",
    "core:window:allow-set-badge-count",
    "core:app:allow-set-app-theme",
    "core:webview:allow-create-webview",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-webview-close",
    "os:default",
    "os:allow-os-type",
    "os:allow-arch",
    "os:allow-version",
    "process:default",
    "process:allow-exit",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-write-text",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "dialog:allow-save",
    "shell:default",
    "shell:allow-open",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path",
    "mic-recorder:default",
    "log:default",
    "log:allow-log"
  ]
}
