{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default-capability",
  "description": "Capability for the main window",
  "platforms": ["macOS", "windows", "linux"],
  "windows": [
    "home",
    "login",
    "tray",
    "checkupdate",
    "update",
    "about",
    "forgetPassword",
    "register",
    "onlineStatus",
    "capture",
    "notify",
    "rtcCall",
    "imageViewer",
    "videoViewer",
    "previewFile",
    "chat-history",
    "fileManager",
    "mail",
    "modal-remoteLogin",
    "modal-serviceAgreement",
    "modal-privacyAgreement",
    "modal-secretChat",
    "settings",
    "lockScreen",
    "multiMsg*",
    "windowChat--*",
    "alone*"
  ],
  "permissions": [
    "core:default",
    "core:webview:deny-internal-toggle-devtools",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-hide",
    "core:window:allow-center",
    "core:window:allow-show",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-unminimize",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-size",
    "core:window:allow-unmaximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-enabled",
    "core:webview:allow-create-webview",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-webview-close",
    "os:default",
    "os:allow-os-type",
    "os:allow-arch",
    "os:allow-version",
    "process:default",
    "process:allow-exit",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-write-text",
    "http:allow-fetch",
    "http:allow-fetch-cancel",
    "http:allow-fetch-read-body",
    "http:allow-fetch-send",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "dialog:allow-save",
    "shell:default",
    "shell:allow-open",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path",
    "mic-recorder:default",
    "log:default",
    "log:allow-log",
    {
      "identifier": "fs:write-files",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPCACHE/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:read-dirs",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$RESOURCE/**"
        }
      ]
    },
    {
      "identifier": "fs:read-files",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$RESOURCE/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$RESOURCE/**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://gitee.com"
        },
        {
          "url": "https://gitee.com:**"
        },
        {
          "url": "https://api.siliconflow.cn"
        },
        {
          "url": "https://api.siliconflow.cn:**"
        },
        {
          "url": "https://translate.googleapis.com"
        },
        {
          "url": "https://translate.googleapis.com:**"
        },
        {
          "url": "https://matrix.test"
        },
        {
          "url": "https://matrix.test:**"
        },
        {
          "url": "https://localhost:**"
        },
        {
          "url": "http://localhost:**"
        },
        {
          "url": "https://127.0.0.1:**"
        },
        {
          "url": "http://127.0.0.1:**"
        }
      ]
    }
  ]
}
