{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tjg",
  "version": "3.0.10",
  "identifier": "com.tjg.pc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:6130"
  },
  "bundle": {
    "resources": [
      "tray",
      "configuration",
      "draco"
    ],
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "files": {}
      },
      "rpm": {
        "epoch": 0,
        "files": {},
        "release": "1"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "登录",
        "label": "login",
        "url": "/login",
        "fullscreen": false,
        "resizable": false,
        "center": true,
        "width": 420,
        "height": 640,
        "skipTaskbar": false,
        "transparent": false,
        "decorations": false,
        "visible": false
      },
      {
        "label": "tray",
        "url": "/tray",
        "resizable": false,
        "center": false,
        "visible": false,
        "width": 130,
        "height": 44,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false
      },
      {
        "label": "checkupdate",
        "url": "/checkupdate",
        "resizable": false,
        "center": true,
        "closable": false,
        "width": 500,
        "height": 600,
        "visible": false,
        "decorations": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: https://asset.localhost http://asset.localhost http://localhost:6130; img-src 'self' tauri: asset: https://asset.localhost http://asset.localhost data: blob: https:; media-src 'self' tauri: asset: https://asset.localhost http://asset.localhost data: blob: https: mediastream:; connect-src 'self' ipc: https: wss: ws://localhost:6130 tauri: https://asset.localhost http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' http://localhost:6130; font-src 'self' data: https://at.alicdn.com; worker-src 'self' blob:; frame-src 'self' https:;"
    },
    "macOSPrivateApi": true
  }
}
