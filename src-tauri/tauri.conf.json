{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tjg",
  "version": "3.0.10",
  "identifier": "com.tjg.pc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5210"
  },
  "bundle": {
    "category": "SocialNetworking",
    "copyright": "龙卷风",
    "licenseFile": "./copyright/License.rtf",
    "resources": [
      "tray",
      "configuration",
      "draco",
      "docs",
      "resources"
    ],
    "createUpdaterArtifacts": false,
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ],
    "windows": {},
    "macOS": {}
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self' tauri: asset: https://asset.localhost http://asset.localhost; img-src 'self' tauri: asset: https://asset.localhost http://asset.localhost data: blob: https:; media-src 'self' tauri: asset: https://asset.localhost http://asset.localhost data: blob: https: mediastream:; connect-src 'self' ipc: http://ipc.localhost tauri: https://asset.localhost http://asset.localhost https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com https: wss: http: ws:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self' data: https://at.alicdn.com; worker-src 'self' blob:; frame-src 'none';",
      "capabilities": [
        "default-capability",
        "storage-capability",
        "network-capability",
        "updater-capability",
        "autostart-capability",
        "mobile-capability"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**",
          "$CACHE/**",
          "$TEMP/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2MUQyQ0Q5RTlFMjkwRDYKUldUV2tPTHAyU3dkZHFXbGdjM0tyMnEwUGNjaUNuMHAvTUxjcERrRndzVk9ic1VneHA4cFFSZGQK"
    }
  }
}
