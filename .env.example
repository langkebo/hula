# 项目名称
VITE_APP_NAME="HuLa"
# 客户端项目地址
VITE_PC_URL="https://gitee.com/llangkebo/hula"
# 后端项目地址 (synapse-rust Matrix Homeserver)
VITE_SERVICE_URL="https://gitee.com/llangkebo/synapse-rust"
# Matrix Homeserver 地址
VITE_HOMESERVER_URL="http://localhost:8008"
# 开发代理目标（可选）：当 VITE_HOMESERVER_URL 是 .test 域名但 nginx 未启动时，
# 设置此变量直连后端，如 VITE_PROXY_TARGET="http://localhost:8008"
# VITE_PROXY_TARGET=""
# Identity Server 地址（synapse-rust 本地联调可留空）
# VITE_IDENTITY_SERVER_URL=""
# Prometheus 指标接收地址（可选）
# VITE_PROMETHEUS_ENDPOINT="http://localhost:9091/metrics/job/hula"
# gitee token (DO NOT commit real tokens)
# VITE_GITEE_TOKEN=""

# 日志级别控制: off | error | warn | info | debug | trace
# 开发环境默认 info，生产环境默认 warn
VITE_LOG_LEVEL=warn
