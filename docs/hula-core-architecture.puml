@startuml hula-core-architecture

!theme toy
skinparam componentStyle uml2

package "Frontend (Vue 3.5+)" {
    [UI Components (Naive UI / Vant)] as UI
    [Matrix Store (Pinia)] as MatrixStore
    [User Store (Pinia)] as UserStore
    [Service Discovery UI] as SDUI
}

package "Core SDK Layer" {
    [Matrix JS SDK] as MatrixSDK
    [Service Discovery SDK] as SD_SDK
    [Auth Service] as Auth
}

package "Desktop/Mobile Container (Tauri 2.x)" {
    [Tauri Core] as Tauri
    [SQLite (im_user)] as DB
    [Log Plugin] as Log
    [HTTP Plugin] as HTTP_P
    [FS Plugin] as FS
}

package "Backend Services" {
    [Matrix Homeserver] as HS
    [Service Registry (Consul/Etcd)] as Registry
    [Microservices] as MS
}

' Relationships
UI --> MatrixStore
UI --> SDUI
MatrixStore --> MatrixSDK
SDUI --> SD_SDK

MatrixSDK --> Tauri : IPC
SD_SDK --> Tauri : IPC

Tauri --> DB : Persist Tokens
Tauri --> HS : HTTPS (Matrix)
Tauri --> Registry : Health Check / Discover
Tauri --> MS : Load Balanced Requests

@enduml
