    "td": "tauri dev",
    "adev:win": "set TAURI_ENV_PLATFORM=android&& vite",
    "idev:mac": "TAURI_ENV_PLATFORM=ios vite",
    "adev": "tauri android dev",
    "idev": "tauri ios dev",
    "adev:reverse": "adb reverse tcp:5210 tcp:5210 && tauri android dev",
    "idev:mac-host": "echo 'iOS 真机需要手动设置系统代理或使用 ngrok/局域网直连' && exit 1",
