    "check:write": "biome check --write --unsafe",
    "knip": "knip --no-exit-code",
    "format:vue": "pnpm dlx prettier --write \"src/**/*.vue\"",
    "format:all": "pnpm check:write && pnpm format:vue",
    "lint:s": "lint-staged && vue-tsc --noEmit",
    "lint:staged": "lint-staged && vue-tsc --noEmit",
    "prepare": "husky",
    "release": "release-it",
    "addition-commit": "git add . && git commit --amend --no-edit",
    "test:run": "node scripts/run-vitest.js run",
    "test:ui": "node scripts/run-vitest.js --ui --coverage.enabled=true",
    "coverage": "node scripts/run-vitest.js run --coverage",
    "skill": "node scripts/link-skills.js",
    "gitcz": "git-cz",
    "create:refactor": "node scripts/create-hula-refactor.js",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "analyze": "vite build --mode production",
    "metrics:bundle": "node scripts/report-bundle-metrics.mjs",
    "probe:admin": "node scripts/probe-admin-features.mjs",
    "check:sdk-types": "node scripts/check-sdk-augmentations.mjs",
    "check:v-html": "node scripts/check-v-html.mjs",
    "check:doc-coverage": "node scripts/check-doc-coverage.mjs",
    "check:sdk-boundary": "node scripts/check-sdk-boundary.mjs",
    "check:bare-matrix-paths": "node scripts/check-bare-matrix-paths.mjs",
    "check:bare-matrix-paths:strict": "node scripts/check-bare-matrix-paths.mjs --strict",
    "check:ratchet": "node scripts/check-ratchet.mjs",
    "check:settings-wiring": "node scripts/check-settings-wiring.mjs",
    "check:component-contracts": "node scripts/check-component-contracts.mjs",
    "check:i18n-dead-keys": "node scripts/check-i18n-dead-keys.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "verify:sdk-pin": "node scripts/verify-sdk-pin.mjs",
    "quality:no-raw-fetch": "node scripts/check-no-raw-fetch.mjs",
    "check:guard-patterns": "node scripts/check-guard-patterns.mjs",
    "check:sdk-aliases": "node scripts/verify-sdk-aliases.mjs",
    "lint": "biome check",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "node scripts/run-vitest.js run",
    "test:stability": "node scripts/run-vitest.js run src/services/matrix/__tests__/stability.contract.test.ts src/utils/__tests__/ExecutionGuard.test.ts",
    "test:contract": "node scripts/run-vitest.js run src/services/matrix/__tests__/stability.contract.test.ts src/utils/__tests__/ExecutionGuard.test.ts src/utils/__tests__/ErrorTracker.test.ts src/services/matrix/__tests__/MatrixClientService.spec.ts",
    "test:crypto-health": "node scripts/test-crypto-health.js",
    "audit:deps": "node scripts/audit-deps.mjs",
    "deploy:openclaw": "bash scripts/deploy_openclaw.sh",
    "test:e2e:mobile": "playwright test --project=mobile-chromium --project=mobile-safari",
    "test:e2e:dynamic": "playwright test e2e/dynamic-flow.spec.ts --project=mobile-chromium",
    "check:a11y": "node scripts/check-a11y.mjs"
  },
