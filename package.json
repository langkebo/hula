    "vue": "^3.5.39",
    "vue-cropper": "1.1.4",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "3.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
