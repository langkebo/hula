    "tauri:build": "node scripts/interactive-build-inquirer.js",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:android:dev": "tauri android dev",
    "tauri:icon": "tauri icon public/light.png",
    "preinstall": "pnpm dlx only-allow pnpm && node scripts/check-all.js",
    "commit": "git add . && git-cz",
    "check": "pnpm gen:i18n && biome check && node scripts/check-i18n.mjs && node scripts/check-i18n-refs.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n-refs": "node scripts/check-i18n-refs.mjs",
    "check:icon-colors": "python3 scripts/audit-icon-colors.py",
