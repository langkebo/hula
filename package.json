    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.5",
    "web-vitals": "^5.3.0"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "pnpm": {
    "overrides": {
      "conventional-changelog-conventionalcommits": "8.0.0",
      "lodash": "^4.18.1",
      "flatted": ">=3.4.2",
      "undici": ">=6.24.0",
      "defu": ">=6.1.5",
      "basic-ftp": ">=5.3.0",
      "yaml": ">=2.8.3",
      "tmp": ">=0.2.4",
      "postcss": ">=8.5.10",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "brace-expansion": ">=5.0.5",
      "uuid@<14.0.0": ">=14.0.0"
    },
    "ignoredBuiltDependencies": ["@parcel/watcher", "esbuild", "sharp", "tlbs-map-vue"]
  }
