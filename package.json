{
  "name": "hula",
  "type": "module",
  "version": "3.0.10",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0 <25",
    "pnpm": ">=10"
  },
  "repository": {
    "url": "https://gitee.com/llangkebo/hula/.git"
  },
  "author": {
    "name": "龙卷风",
    "email": "656042408@qq.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri:dev": "tauri dev",
    "td": "tauri dev",
    "adev:win": "set TAURI_ENV_PLATFORM=android&& vite",
    "idev:mac": "TAURI_ENV_PLATFORM=ios vite",
    "adev": "tauri android dev",
    "idev": "tauri ios dev",
    "tb": "node scripts/interactive-build-inquirer.js",
    "tauri:build": "node scripts/interactive-build-inquirer.js",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:android:dev": "tauri android dev",
    "tauri:icon": "tauri icon public/light.png",
    "preinstall": "pnpm dlx only-allow pnpm && node scripts/check-all.js",
    "commit": "git add . && git-cz",
    "check": "pnpm gen:i18n && biome check && node scripts/check-i18n.mjs",
    "check:ci": "pnpm gen:i18n && biome ci && node scripts/check-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "gen:i18n": "node scripts/generate-i18n-types.mjs",
    "check:write": "biome check --write --unsafe",
    "format:vue": "pnpm dlx prettier --write \"src/**/*.vue\"",
    "format:all": "pnpm check:write && pnpm format:vue",
    "lint:s": "lint-staged && vue-tsc --noEmit",
    "lint:staged": "lint-staged && vue-tsc --noEmit",
    "prepare": "husky",
    "release": "release-it",
    "addition-commit": "git add . && git commit --amend --no-edit",
    "test:run": "node scripts/run-vitest.js run",
    "test:ui": "node scripts/run-vitest.js --ui --coverage.enabled=true",
    "coverage": "node scripts/run-vitest.js run --coverage",
    "skill": "node scripts/link-skills.js",
    "gitcz": "git-cz",
    "create:refactor": "node scripts/create-hula-refactor.js",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "analyze": "vite build --mode production",
    "metrics:bundle": "node scripts/report-bundle-metrics.mjs",
    "probe:admin": "node scripts/probe-admin-features.mjs",
    "check:sdk-types": "node scripts/check-sdk-augmentations.mjs",
    "check:v-html": "node scripts/check-v-html.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "sdk:pack:apply": "node scripts/sdk-pack-apply.mjs",
    "sdk:pin:refresh": "node scripts/sdk-pin-refresh.mjs",
    "verify:sdk-pin": "node scripts/verify-sdk-pin.mjs",
    "check:release": "node scripts/check-release.mjs",
    "deploy:openclaw": "bash scripts/deploy_openclaw.sh",
    "test:e2e:mobile": "playwright test --project=mobile-chromium --project=mobile-safari",
    "test:e2e:dynamic": "playwright test e2e/dynamic-flow.spec.ts --project=mobile-chromium"
  },
