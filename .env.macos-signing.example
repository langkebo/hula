# =============================================================================
# macOS 分发版签名 / 公证环境变量模板
# =============================================================================
# 用法：复制本文件为 .env.local（已被 .gitignore 忽略），按实际情况填入值。
#   cp .env.macos-signing.example .env.local
# 切勿提交含真实凭据的 .env.local。
#
# 说明：Tauri 2 的公证凭据与签名身份只从环境变量读取，不写入 tauri.*.conf.json。
# config 中 bundle.macOS.signingIdentity 设为 "-"（ad-hoc 占位），保证本机
# 未配置凭据时仍能打出可运行的 dmg；下列变量存在时会覆盖该占位值。

# ── 方式 A：用 Apple ID + App 专用密码公证（二选一） ──────────────────────────
# Apple ID 邮箱
APPLE_ID=""
# App 专用密码（在 appleid.apple.com 生成，不是账户登录密码）
APPLE_PASSWORD=""
# Apple Developer Team ID（形如 ABC123DEFG）
APPLE_TEAM_ID=""

# ── 方式 B：用 App Store Connect API 密钥公证（二选一，CI 推荐） ──────────────
# 若方式 A 三个变量都已设置，Tauri 优先用方式 A，可忽略本组。
# API Issuer ID
# APPLE_API_ISSUER=""
# API Key ID
# APPLE_API_KEY=""
# 下载的 AuthKey_<KEY_ID>.p8 私钥路径（亦可放在 ./private_keys 或 ~/.private_keys 自动发现）
# APPLE_API_KEY_PATH=""

# ── 签名身份 ──────────────────────────────────────────────────────────────────
# Developer ID Application 证书在钥匙串中的全名。
# 用 `security find-identity -v -p codesigning` 查看，例如：
#   Developer ID Application: Long Juanfeng (ABC123DEFG)
# 该项覆盖 config 里的 signingIdentity="-"。留空则沿用 ad-hoc 占位。
APPLE_SIGNING_IDENTITY=""

# ── CI 专用：从 base64 .p12 导入证书到临时钥匙串 ─────────────────────────────
# 本机已把证书装进 login 钥匙串时无需设置下面两项。
# .p12 证书的 base64 编码（openssl base64 -A -in cert.p12）
# APPLE_CERTIFICATE=""
# 导出 .p12 时设置的密码
# APPLE_CERTIFICATE_PASSWORD=""
